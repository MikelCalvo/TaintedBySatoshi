{
  "name": "tainted-by-satoshi-backend",
  "version": "1.1.0",
  "description": "Backend API for checking Bitcoin addresses connected to Satoshi",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "node --test test/**/*.test.js",
    "check-node": "node src/scripts/checkNodeStatus.js",
    "update-satoshi-data": "node --expose-gc --max-old-space-size=8192 src/scripts/updateSatoshiData.js",
    "check-satoshi-data": "node src/scripts/checkSatoshiData.js"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bitcoinjs-lib": "^7.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "level": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "allowScripts": {
    "classic-level@3.0.0": true
  },
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
